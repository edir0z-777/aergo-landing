{
  "name": "aergo-landing",
  "version": "1.0.0",
  "private": true,
  "description": "AERGO LLC corporate landing page (static HTML + Tailwind CSS)",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./site/styles.css --minify",
    "dev": "tailwindcss -i ./src/input.css -o ./site/styles.css --watch",
    "serve": "npx --yes serve site"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
